function draghack.ParseBones( ply, bone )
    local mdl = ply:GetModel()

    if draghack.parsedbones[ mdl ] and draghack.parsedbones[ mdl ][ bone ] then 
        return draghack.parsedbones[ mdl ][ bone ]
    end

    if not draghack.parsedbones[ mdl ] then
        draghack.parsedbones[ mdl ] = {}
    end
        
    local set = ply:GetHitboxSet()
    local bonecount = ply:GetBoneCount()

    for i = 0, bonecount - 1 do 
		local group = ply:GetHitBoxHitGroup( i, set )

        if group == nil then continue end

		if bone == group then
			draghack.parsedbones[ mdl ][ bone ] = i

            return i
        end
	end

    for i = 0, bonecount - 1 do 
        local group = ply:GetHitBoxHitGroup( i, set )

        if group == nil then continue end

        if bone > 1 and group == 0 then
            draghack.parsedbones[ mdl ][ bone ] = i

            return i
        end
    end

    return 0
end

function draghack.MultipointGroupCheck( group )
    if group == 1 and not draghack.cfg["Multipoint groups-Head"] then return false end
    if group == 2 and not draghack.cfg["Multipoint groups-Chest"] then return false end
    if group == 3 and not draghack.cfg["Multipoint groups-Stomach"] then return false end
    if group == 4 or group == 5 and not draghack.cfg["Multipoint groups-Arms"] then return false end
    if group == 6 or group == 7 and not draghack.cfg["Multipoint groups-Legs"] then return false end
    if group == 0 and not draghack.cfg["Multipoint groups-Generic"] then return false end

    return true 
end

function draghack.GetBones( ply )
    local scale = draghack.cfg["Multipoint scale"]
    local pos = ply:LocalToWorld( ply:OBBCenter() )
    local set = ply:GetHitboxSet()

    if draghack.cfg["Hitscan"] then
        local set = ply:GetHitboxSet()
        local bonecount = ply:GetBoneCount()

        pos = {}

        for i = 0, bonecount - 1 do 
            local group = ply:GetHitBoxHitGroup( i, set )

            if group == nil then continue end

            if group == 1 and not draghack.cfg["Hitscan groups-Head"] then continue end
            if group == 2 and not draghack.cfg["Hitscan groups-Chest"] then continue end
            if group == 3 and not draghack.cfg["Hitscan groups-Stomach"] then continue end
            if group == 4 or group == 5 and not draghack.cfg["Hitscan groups-Arms"] then continue end
            if group == 6 or group == 7 and not draghack.cfg["Hitscan groups-Legs"] then continue end
            if group == 0 and not draghack.cfg["Hitscan groups-Generic"] then continue end

            pos[ #pos + 1 ] = { bone = i, hitgroup = group }
        end

        if not pos or not istable( pos ) then return end

        local valid = {}

        for i = 1, #pos do
            local bone = pos[ i ].bone
            local hitboxbone = ply:GetHitBoxBone( bone, set )

            if hitboxbone == nil then 
                continue 
            end 

            local mins, maxs = ply:GetHitBoxBounds( bone, set )

            if not mins or not maxs then 
                continue
            end 

            local bonepos, ang = ply:GetBonePosition( hitboxbone )
            
            if draghack.cfg["Multipoint"] and draghack.MultipointGroupCheck( pos[ i ].hitgroup ) then
                local points = {
                    ( ( mins + maxs ) * 0.5 ),
                    Vector( mins.x, mins.y, mins.z ),
                    Vector( mins.x, maxs.y, mins.z ),
                    Vector( maxs.x, maxs.y, mins.z ),
                    Vector( maxs.x, mins.y, mins.z ),
                    Vector( maxs.x, maxs.y, maxs.z ),
                    Vector( mins.x, maxs.y, maxs.z ),
                    Vector( mins.x, mins.y, maxs.z ),
                    Vector( maxs.x, mins.y, maxs.z )
                }

                for i = 1, #points do
                    points[ i ]:Rotate( ang )
                    points[ i ] = points[ i ] + bonepos

                    if i == 1 then continue end 

                    points[ i ] = ( ( points[ i ] - points[1] ) * scale ) + points[ 1 ]
                    valid[ #valid + 1 ] = points[ i ]
                end
            end 

            mins:Rotate( ang )
            maxs:Rotate( ang )

            valid[ #valid + 1 ] = bonepos + ( ( mins + maxs ) * 0.5 )
        end

        return valid
    else
        local bone = draghack.ParseBones( ply, draghack.cfg["Hitbox selection"] ) 

        local hitboxbone = ply:GetHitBoxBone( bone, set )

        if hitboxbone == nil then 
            return { pos }  
        end 

        local mins, maxs = ply:GetHitBoxBounds( bone, set )

        if not mins or not maxs then 
            return { pos } 
        end 

        local bonepos, ang = ply:GetBonePosition( hitboxbone )  

        if draghack.cfg["Multipoint"] then
            local points = {
                ( ( mins + maxs ) * 0.5 ),
                Vector( mins.x, mins.y, mins.z ),
                Vector( mins.x, maxs.y, mins.z ),
                Vector( maxs.x, maxs.y, mins.z ),
                Vector( maxs.x, mins.y, mins.z ),
                Vector( maxs.x, maxs.y, maxs.z ),
                Vector( mins.x, maxs.y, maxs.z ),
                Vector( mins.x, mins.y, maxs.z ),
                Vector( maxs.x, mins.y, maxs.z )
            }

            for i = 1, #points do
                points[ i ]:Rotate( ang )
                points[ i ] = points[ i ] + bonepos

                if i == 1 then continue end 

                points[ i ] = ( ( points[ i ] - points[1] ) * scale ) + points[ 1 ]
            end

            return points
        else 
            mins:Rotate( ang )
            maxs:Rotate( ang )

            pos = bonepos + ( ( mins + maxs ) * 0.5 )
        end
    end

    return { pos }
end

function draghack.GetSortedPlayers( mode, selfpred, plypred, vischeck )
    local players   = player.GetAll()   
    local eyepos    = pLocalPlayer:EyePos()       
    local valid     = {}   

	if selfpred then
		eyepos = eyepos + (pLocalPlayer:GetVelocity() * flTickInterval) * selfpred
	end

    local iTeamLocal = draghack.GetTeam( pLocalPlayer )

    for i = 1, #players do
        local v = players[i]

        if v == pLocalPlayer then 
            continue 
        end 

        if not v:Alive() or v:IsDormant() then 
            continue 
        end

        if draghack.cfg["Ignores-Bots"] and v:IsBot() then continue end 
        if draghack.cfg["Ignores-Friends"] and draghack.cfg.friends[v:SteamID()] then continue end 
        if draghack.cfg["Ignores-Steam friends"] and v:GetFriendStatus() == "friend" then continue end 
        if draghack.cfg["Ignores-Admins"] and v:IsAdmin() then continue end 
        if draghack.cfg["Ignores-Frozen"] and v:IsFlagSet( FL_FROZEN ) then continue end 
        if draghack.cfg["Ignores-Nodraw"] and v:IsEffectActive( EF_NODRAW ) then continue end 
        if draghack.cfg["Ignores-God time"] and v:GetColor().a < 255 then continue end 
        if draghack.cfg["Ignores-Driver"] and v:InVehicle() then continue end 
        if draghack.cfg["Target-Priority-Only"] and not draghack.cfg.priorityList[v:SteamID()] then continue end

        local iTeamEnemy = draghack.GetTeam( v )

        if st == TEAM_SPECTATOR or draghack.cfg["Ignores-Teammates"] and iTeamLocal == iTeamEnemy then 
            continue 
        end 

        if draghack.cfg["Ignores-Nocliping"] and v:GetMoveType() == MOVETYPE_NOCLIP then 
            continue 
        end 

        if vischeck then
			local bone = draghack.GetBones( v )[1]
			local dir = pLocalPlayer:GetShootPos() - bone
			dir:Normalize()

			if !draghack.VisibleCheck( v, bone, selfpred, dir ) then
				continue
			end
		end

        local pos = v:GetPos()
        if plypred then 
            pos = pos + (v:GetVelocity() * flTickInterval) * plypred
        end

        valid[#valid+1] = { v, pos }
    end

    if mode == 1 then
        table.sort(valid, function( a, b )
            return ( a[2] - eyepos ):LengthSqr() < ( b[2] - eyepos ):LengthSqr()       
        end)
    elseif mode == 2 then
        table.sort(valid, function( a, b )
            local aScr, bScr = a[2]:ToScreen(), b[2]:ToScreen()

            local aDist
            do
                local dx = ( screenWidth * 0.5 ) - aScr.x
                local dy = ( screenHeight * 0.5 ) - aScr.y
                aDist = dx * dx + dy * dy
            end
    
            local bDist
            do
                local dx = ( screenWidth * 0.5 ) - bScr.x
                local dy = ( screenHeight * 0.5 ) - bScr.y
                bDist = dx * dx + dy * dy
            end
    
            return aDist < bDist
        end)
    end

    if #valid == 0 then return end

    return valid
end

function draghack.IsTickHittable( ply, cmd, tick )
    if ded.GetLatency(0) > 1 then return false end

    local serverArriveTick = draghack.flServerTime + ded.GetLatency(0) + ded.GetLatency(1)
    local diff = serverArriveTick - draghack.btrecords[ ply ][ tick ].simulationtime

    if diff > draghack.cfg["Backtrack time"] / 1000 then return false end

    return true
end

function draghack.FindBacktrack( cmd, ply )
    local ticks = #draghack.btrecords[ ply ]
    local canhit = {}

    for i = 1, ticks do
        if draghack.IsTickHittable( ply, cmd, i ) then
            canhit[ #canhit + 1 ] = i
        end
    end

    return canhit
end

function draghack.FindFirstHittableTicks( ply, cmd )
    local tickcount = #draghack.btrecords[ ply ]

    if !tickcount then return 1 end

    for i = 1, tickcount do
        if draghack.IsTickHittable( ply, cmd, i ) then
            return i
        end
    end
end

do
