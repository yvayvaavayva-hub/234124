function draghack.CalcView( ply, origin, angles, fov, znear, zfar )
    if draghack.UnSafeFrame then 
        return { origin = origin, angles = angles, fov = fov } 
    end

    local view = {}

    local tppressed = draghack.IsKeyDown(draghack.cfg.binds["Third person"])
    local fcpressed = draghack.IsKeyDown(draghack.cfg.binds["Free camera"])

    if draghack.cfg["Third person"] and tppressed and not draghack.tptoggled then
        draghack.tpenabled = not draghack.tpenabled
    end

    if draghack.cfg["Free camera"] and fcpressed and not draghack.fctoggled then
        draghack.fcenabled = not draghack.fcenabled
        draghack.fcangles = pLocalPlayer:EyeAngles()
    elseif draghack.fcenabled and not draghack.cfg["Free camera"] then
        draghack.fcenabled = false
    end

    draghack.tptoggled = tppressed
    draghack.fctoggled = fcpressed


    if draghack.cfg["Fake duck"] and draghack.IsKeyDown(draghack.cfg.binds["Fake duck"]) then
        origin.z = pLocalPlayer:GetPos().z + 64
    end

    local fangs = draghack.cfg["Silent aim"] and draghack.SilentAngle or angles

    //angles = fangs
    //if not draghack.cfg[ "Norecoil" ] then
    //    angles:Add( ply:GetViewPunchAngles() )
    //end

    if draghack.fcenabled then
        local speed = draghack.cfg["Free camera speed"]
        
        if input.IsKeyDown(KEY_W) then
            draghack.fcvector = draghack.fcvector + draghack.SilentAngle:Forward() * speed
        end

        if input.IsKeyDown(KEY_S) then
            draghack.fcvector = draghack.fcvector - draghack.SilentAngle:Forward() * speed
        end

        if input.IsKeyDown(KEY_A) then
            draghack.fcvector = draghack.fcvector - draghack.SilentAngle:Right() * speed
        end

        if input.IsKeyDown(KEY_D) then
            draghack.fcvector = draghack.fcvector + draghack.SilentAngle:Right() * speed
        end

        if input.IsKeyDown(KEY_SPACE) then
            draghack.fcvector.z = draghack.fcvector.z + speed
        end

        if input.IsKeyDown(KEY_LSHIFT) then
            draghack.fcvector.z = draghack.fcvector.z - speed
        end

        view.origin = draghack.fcvector
        view.angles = fangs
        view.fov = draghack.cfg["Fov override"]
        view.drawviewer = !draghack.cfg["Ghetto free cam"]
    else
        draghack.fcvector = origin
        view.origin = draghack.tpenabled and origin - ( (fangs):Forward() * draghack.cfg["Third person distance"] ) or origin

        if draghack.tpenabled and draghack.cfg["Third person collision"] then
            local tr = {}

            tr.start = origin
            tr.endpos = origin - ( (fangs):Forward() * draghack.cfg["Third person distance"] )
            tr.mins = draghack.cameraHullMin
            tr.maxs = draghack.cameraHullMax
            tr.filter = ply
            tr.mask = MASK_BLOCKLOS

            local res = TraceHull( tr )

            view.origin = res.HitPos
        end

        view.angles = fangs
        view.fov = draghack.cfg["Fov override"]
        view.drawviewer = hook.Call( "ShouldDrawLocalPlayer", nil, ply )
    end

    draghack.vieworigin = ( draghack.cfg["Ghetto free cam"] and draghack.fcenabled ) and draghack.fcvector or origin
    draghack.viewfov    = view.fov
    draghack.znear      = znear

    if ( not draghack.cfg["Override view"] ) then
        if ( math.floor( fov ) ~= GetConVar( "fov_desired" ):GetFloat() ) then
            view.fov = fov 
        end

        local pVehicle = pLocalPlayer:GetVehicle()

        if ( IsValid( pVehicle ) ) then
            view = hook.Run( "CalcVehicleView", pVehicle, ply, view )
        end

        local pWeapon = pLocalPlayer:GetActiveWeapon()
        
        if ( IsValid( pWeapon ) ) then
            local pWeaponCalcView = pWeapon.CalcView 

            if ( pWeaponCalcView ) then
                local origin, angles, fov = pWeaponCalcView( pWeapon, ply, Vector( view.origin ), Angle( view.angles ), view.fov ) 
			    view.origin, view.angles, view.fov = origin or view.origin, angles or view.angles, fov or view.fov
            end
        end
    end
	return view
end

function draghack.GetFovRadius()
    local Radius = draghack.cfg["Aimbot FOV"]

    local Ratio = screenWidth / screenHeight
    local AimFOV = Radius * (math.pi / 180)
    local GameFOV = draghack.viewfov * (math.pi / 180)
    local ViewFOV = 2 * math.atan(Ratio * (draghack.znear / 2) * math.tan(GameFOV / 2))



    return (math.tan(AimFOV) / math.tan(ViewFOV / 2)) * screenWidth
end

function draghack.CalcViewModelView(wep, vm, oldPos, oldAng, pos, ang)
    local mode = draghack.cfg["CalcViewModelView"] or 1
    local origin = pos
    local angles = ang or (pLocalPlayer and pLocalPlayer:EyeAngles() or Angle(0, 0, 0))

    local silentAngles = draghack.cfg["Silent aim"] and draghack.SilentAngle or angles

    if mode == 1 then
        origin = draghack.vieworigin or origin
        angles = silentAngles
    elseif mode == 2 then
        origin = draghack.vieworigin or origin
        angles = silentAngles

        if IsValid(wep) then
            if wep.GetViewModelPosition then
                local p, a = wep:GetViewModelPosition(Vector(origin), Angle(angles))
                origin, angles = p or origin, a or angles
            end

            if wep.CalcViewModelView then
                local p, a = wep:CalcViewModelView(vm, Vector(oldPos), Angle(oldAng), Vector(origin), Angle(angles))
                origin, angles = p or origin, a or angles
            end
        end
    end

    if draghack.cfg["Viewmodel position"] then

		local OverridePos = Vector(draghack.cfg["Viewmodel X"], draghack.cfg["Viewmodel Y"], draghack.cfg["Viewmodel Z"])
		local OverrideAngle = Angle(draghack.cfg["Viewmodel Pitch"], draghack.cfg["Viewmodel Yaw"], draghack.cfg["Viewmodel Roll"])

		angles = angles * 1

		angles:RotateAroundAxis(angles:Right(), OverrideAngle.x * 1.0)
		angles:RotateAroundAxis(angles:Up(), OverrideAngle.y * 1.0)
		angles:RotateAroundAxis(angles:Forward(), OverrideAngle.z* 1.0)

		origin = origin + OverridePos.x * angles:Right() * 1.0
		origin = origin + OverridePos.y * angles:Forward() * 1.0
		origin = origin + OverridePos.z * angles:Up() * 1.0
    end

    return origin, angles
end



