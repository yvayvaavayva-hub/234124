function draghack.DrawFakeModelHitboxes()
    if not draghack.cfg["Hitbox"] then return end
    if not IsValid(draghack.fakeModel) then return end
    if not pLocalPlayer:Alive() then return end
    if draghack.hideHitboxes then return end 
    
    local mymodel = pLocalPlayer:GetModel()
    if draghack.newModel != mymodel then
        draghack.fakeModel = draghack.CS_Model(mymodel)
        draghack.newModel = mymodel
    end

    local tbl = {
        layers = draghack.fakeAngles.layers,
        angles = draghack.fakeAngles.angle,
        sequence = draghack.fakeAngles.seq,
        cycle = draghack.fakeAngles.cycle,
        origin = draghack.fakeAngles.origin,
        movex = draghack.fakeAngles.movex,
        movey = draghack.fakeAngles.movey,
    }
    draghack.CS_Model_update(pLocalPlayer, draghack.fakeModel, tbl)

    if draghack.fakeModel:GetHitBoxGroupCount() != nil then
        cam.Start3D(EyePos(), EyeAngles())
            for group = 0, draghack.fakeModel:GetHitBoxGroupCount() - 1 do 
                for hitbox = 0, draghack.fakeModel:GetHitBoxCount(group) - 1 do
                    local bone = draghack.fakeModel:GetHitBoxBone(hitbox, group)
                    if not bone then continue end
                    
                    local pos, ang = draghack.fakeModel:GetBonePosition(bone)
                    if not pos then continue end
                    
                    local mins, maxs = draghack.fakeModel:GetHitBoxBounds(hitbox, group)
                    render.DrawWireframeBox(
                        pos, 
                        ang, 
                        mins, 
                        maxs, 
                        string.ToColor(draghack.cfg.colors["Hitbox"]), 
                        true
                    )
                end
            end
        cam.End3D()
    end
end

