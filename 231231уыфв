do
    local drawing = false

    function draghack.PreDrawViewModel( vm, ply, w )
        if draghack.UnSafeFrame then return end
        if ply != pLocalPlayer then return end

        if draghack.cfg["Viewmodel chams"] then
            local col
            if draghack.cfg["Viewmodel chams rainbow"] then
                local t = CurTime() * 0.5
                local h = (t % 1)
                local s = 1
                local v = 1
                local alpha = tonumber(draghack.cfg["Viewmodel chams rainbow alpha"] or 255)
                local function HSVToColor(h, s, v, a)
                    local i = math.floor(h * 6)
                    local f = h * 6 - i
                    local p = v * (1 - s)
                    local q = v * (1 - f * s)
                    local t = v * (1 - (1 - f) * s)
                    local r, g, b = 0, 0, 0
                    if i % 6 == 0 then r, g, b = v, t, p
                    elseif i % 6 == 1 then r, g, b = q, v, p
                    elseif i % 6 == 2 then r, g, b = p, v, t
                    elseif i % 6 == 3 then r, g, b = p, q, v
                    elseif i % 6 == 4 then r, g, b = t, p, v
                    elseif i % 6 == 5 then r, g, b = v, p, q end
                    return Color(r * 255, g * 255, b * 255, a or 255)
                end
                col = HSVToColor(h, s, v, alpha)
            else
                col = string.ToColor( draghack.cfg.colors["Viewmodel chams"] )
            end
            draghack.chamMats.vis[6]:SetVector( "$envmaptint", Vector( col.r / 255, col.g / 255, col.b / 255 ) )
            local mat = draghack.chamMats.vis[draghack.cfg["Viewmodel chams type"]]
            render.SetBlend((col.a or 255)/255)
            render.SetColorModulation(col.r/255,col.g/255,col.b/255)
            render.MaterialOverride(mat)
        end

        if draghack.cfg["Fullbright viewmodel"] then
            render.SuppressEngineLighting( true )
        end

        if draghack.cfg["Viewmodel fov"] != GetConVar("viewmodel_fov"):GetInt() and not drawing then
            cam.Start3D(nil, nil, draghack.cfg["Viewmodel fov"])

                drawing = true

                render.DepthRange( 0, 0.01 )

                vm:DrawModel()

                render.DepthRange( 0, 1 )

                drawing = false

            cam.End3D()
        else
            return
        end

        return true
    end

end

function draghack.PostDrawViewModel( vm, ply, w )
    render.SetColorModulation(1, 1, 1)
    render.MaterialOverride()
    render.SetBlend(1)
    render.SuppressEngineLighting(false)
end

