function draghack.entity_killed(data)
    local aid = Entity(data.entindex_attacker)  
    local vid = Entity(data.entindex_killed)

    if aid == pLocalPlayer and aid != vid and !vid:IsNPC() and (vid:IsPlayer() or vid:IsBot() ) then
        if draghack.cfg["Killsay"] then
            local chatPrefixes = {
                [2] = "/ooc ",
                [3] = "/ad ",
                [4] = "/pm "
            }
            
            local chatGroup = draghack.cfg["Killsay group"]
            
            local prefix = chatPrefixes[chatGroup] or ""
        
            local tbl = draghack.chatmsg[ draghack.cfg["Killsay mode"] ]
            local str = prefix .. tbl[ math.random( 1, #tbl ) ]
            
            if str:find("%s") then 
                str = str:gsub("%%s", vid:Nick()) 
            end
            if str:find("%n") then 
                str = str:gsub("%%n", vid:SteamID()) 
            end

            RunConsoleCommand( "say", str )
        end

        
        if draghack.cfg["Killsound"] then
            surface.PlaySound( draghack.cfg["Killsound str"] )
        end

        if draghack.cfg["Killstreak"] then
            draghack.killstreak = (draghack.killstreak or 0) + 1  
            
            if draghack.killstreak > 0 then
                if draghack.killstreak == 1 then
                    surface.PlaySound("firstblood.wav")
                elseif draghack.killstreak == 2 then
                    surface.PlaySound("doublekill.wav")
                elseif draghack.killstreak == 3 then
                    surface.PlaySound("killingspree.wav")
                elseif draghack.killstreak == 4 then
                    surface.PlaySound("unstoppable.wav")
