function draghack.togglevisible()
    if draghack.frame:IsVisible() then
        draghack.frame:SetVisible(false)

        if draghack.ui.MultiComboP then draghack.ui.RemovePanel( draghack.ui.MultiComboP ) end
        if draghack.ui.ColorWindow then draghack.ui.RemovePanel( draghack.ui.ColorWindow ) end
        if draghack.ui.SettingsPan then draghack.ui.RemovePanel( draghack.ui.SettingsPan ) end

        RememberCursorPosition()

        if draghack.validsnd then draghack.validsnd:Pause() end
    else
        draghack.frame:SetVisible(true)

        RestoreCursorPosition()
        if draghack.validsnd then draghack.validsnd:Play() end
    end
end

function draghack.PrePlayerDraw( pEntity, iFlags )
    if ( pEntity == pLocalPlayer ) then
        return 
    end

    if draghack.cfg["Invalidate activity"] then
        pEntity:SetSequence(-1)
    end


    pEntity:SetPoseParameter( "head_pitch", 0 )
    pEntity:SetPoseParameter( "head_yaw", 0 )

    if ( draghack.cfg["Resolver"] ) then
        local angs = Angle()
        angs.y = draghack.bruteYaw[ pEntity.aimshots % #draghack.bruteYaw + 1 ] + pEntity:EyeAngles().y

        pEntity:SetRenderAngles( angs )

        ded.SetCurrentLowerBodyYaw( pEntity:EntIndex(), angs.y )  
    end

    if ( draghack.cfg["Pitch resolver"] and pEntity.fakepitch ) then
        pEntity:SetPoseParameter( "aim_pitch", -89 )
        pEntity:SetPoseParameter( "head_pitch", -89 )
    end
    
    pEntity:InvalidateBoneCache()
    pEntity:SetupBones()

    pEntity.ChatGestureWeight = 0
end

