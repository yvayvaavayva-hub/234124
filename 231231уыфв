function draghack.AutoWall( dir, plyTarget )
	if not draghack.activeWeapon or draghack.swbShit[ draghack.activeWeaponClass ] then return false end 

	local eyePos = pLocalPlayer:EyePos()
	
	local function SWBAutowall()

        draghack.traceStruct.start = eyePos
        draghack.traceStruct.endpos = eyePos + dir * draghack.activeWeapon.PenetrativeRange
        draghack.traceStruct.filter = pLocalPlayer
        draghack.traceStruct.mask = draghack.swbNormal

		local tr = TraceLine( draghack.traceStruct )
		
		if tr.Hit and !tr.HitSky then
			local dot = -dir:Dot(tr.HitNormal)
			
			if draghack.activeWeapon.CanPenetrate and dot > 0.26 then

                draghack.traceStruct.start = tr.HitPos
                draghack.traceStruct.endpos = tr.HitPos + dir * draghack.activeWeapon.PenStr * ( draghack.swbPen[tr.MatType] or 1 ) * draghack.activeWeapon.PenMod
                draghack.traceStruct.filter = pLocalPlayer
                draghack.traceStruct.mask = draghack.swbWall

				tr = TraceLine( draghack.traceStruct )

                draghack.traceStruct.start = tr.HitPos
                draghack.traceStruct.endpos = tr.HitPos + dir * 0.1
                draghack.traceStruct.filter = pLocalPlayer
                draghack.traceStruct.mask = draghack.swbNormal

				tr = TraceLine( draghack.traceStruct) 
				
				if tr.Hit then return false end

                draghack.traceStruct.start = tr.HitPos
                draghack.traceStruct.endpos = tr.HitPos + dir * 32768
                draghack.traceStruct.filter = pLocalPlayer
                draghack.traceStruct.mask = MASK_SHOT

				tr = TraceLine( draghack.traceStruct )
				
                if draghack.cfg["Ignores-Head unhitable"] then
                    return tr.Entity == plyTarget and tr.HitGroup == 1
                else
                    return tr.Entity == plyTarget
                end
			end
		end
		
		return false
	end
	
	local function M9KAutowall()
        local penetrate_cvar = GetConVar( "M9KDisablePenetration" )
        if IsValid(penetrate_cvar) then
            if ( penetrate_cvar:GetBool() ) then
                return false 
            end
        end

		if !draghack.activeWeapon.Penetration then
			return false
		end

		local function BulletPenetrate( tr, bounceNum, damage )
			if damage < 1 then
				return false
			end
			
			local maxPenetration    = 14
            local maxRicochet       = 0
            local isRicochet        = false

            if draghack.m9kPenetration[ draghack.activeWeapon.Primary.Ammo ] then
                maxPenetration = draghack.m9kPenetration[ draghack.activeWeapon.Primary.Ammo ]
            end
			
            if draghack.m9kMaxRicochet[ draghack.activeWeapon.Primary.Ammo ] then
                maxRicochet = draghack.m9kMaxRicochet[ draghack.activeWeapon.Primary.Ammo ]
            end

            if draghack.m9kCanRicochet[ draghack.activeWeapon.Primary.Ammo ] then
                isRicochet = draghack.m9kMaxRicochet[ draghack.activeWeapon.Primary.Ammo ]
            end

			if tr.MatType == MAT_METAL and isRicochet and draghack.activeWeapon.Primary.Ammo != "SniperPenetratedRound" then
				return false
			end

			if bounceNum > maxRicochet then
				return false
			end

			local penetrationDir = tr.Normal * maxPenetration

			if draghack.m9kPenMaterial[ tr.MatType ] then
				penetrationDir = tr.Normal * ( maxPenetration * 2 ) 
			end

			if tr.Fraction <= 0 then
				return false
			end

			draghack.traceStruct.endpos    = tr.HitPos
			draghack.traceStruct.start     = tr.HitPos + penetrationDir
			draghack.traceStruct.mask      = MASK_SHOT
			draghack.traceStruct.filter    = pLocalPlayer

			local trace = TraceLine( draghack.traceStruct )

			if trace.StartSolid or trace.Fraction >= 1 then
				return false
			end

			draghack.traceStruct.endpos = trace.HitPos + tr.Normal * 32768
			draghack.traceStruct.start  = trace.HitPos
			draghack.traceStruct.mask   = MASK_SHOT
			draghack.traceStruct.filter = pLocalPlayer

			local penTrace = TraceLine( draghack.traceStruct )

            if draghack.cfg["Ignores-Head unhitable"] then
                return penTrace.Entity == plyTarget and penTrace.HitGroup == 1
            else
                return penTrace.Entity == plyTarget
            end

			local damageMulti = 0.5
			if draghack.activeWeapon.Primary.Ammo == "SniperPenetratedRound" then
				damageMulti = 1
			elseif tr.MatType == MAT_CONCRETE or tr.MatType == MAT_METAL then
				damageMulti = 0.3
			elseif tr.MatType == MAT_WOOD or tr.MatType == MAT_PLASTIC or tr.MatType == MAT_GLASS then
				damageMulti = 0.8
			elseif tr.MatType == MAT_FLESH or tr.MatType == MAT_ALIENFLESH then
				damageMulti = 0.9
			end
			
			if penTrace.MatType == MAT_GLASS then
				bounceNum = bounceNum - 1
			end

			return BulletPenetrate( penTrace, bounceNum + 1, damage * damageMulti )
		end

        draghack.traceStruct.start = eyePos
        draghack.traceStruct.endpos = eyePos + dir * 32768
        draghack.traceStruct.filter = pLocalPlayer
        draghack.traceStruct.mask = MASK_SHOT

		local trace = TraceLine( draghack.traceStruct )

		return BulletPenetrate( trace, 0, draghack.activeWeapon.Primary.Damage )
	end
	
    if string.StartsWith( draghack.activeWeaponClass, "m9k_" ) or string.StartsWith( draghack.activeWeaponClass, "bender_" ) then
		return M9KAutowall()
	elseif string.StartsWith( draghack.activeWeaponClass, "swb_" ) then
		return SWBAutowall()
	end
	
	return false
end

function draghack.VisibleCheck( who, where, predticks, awalldir )
    local start = pLocalPlayer:EyePos()

    if predticks then start = start + ( pLocalPlayer:GetVelocity() * flTickInterval ) * predticks end

    draghack.traceStruct.start = start
	draghack.traceStruct.endpos = where
	draghack.traceStruct.mask = MASK_SHOT
    draghack.traceStruct.filter = pLocalPlayer

    local tr = TraceLine( draghack.traceStruct )

    local canhit = tr.Entity == who or tr.Fraction == 1

    if !canhit and awalldir and draghack.cfg["Wallz"] then 
        return draghack.AutoWall( awalldir, who )
    end

    if draghack.cfg["Ignores-Head unhitable"] and tr.HitGroup != 1 then return false end

    return canhit
end

