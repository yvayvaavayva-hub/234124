function draghack.drawCSModels_backtrack()
    if not draghack.cfg["Backtrack chams"] then return end 
    if not draghack.canBacktrack(draghack.target) then return end

    local len = #draghack.btrecords[draghack.target]
    local tbl = draghack.btrecords[draghack.target][draghack.backtracktick]
    local m = draghack.btmodel

    draghack.CS_Model_update(draghack.target,m,tbl)

    if draghack.cfg["Backtrack fullbright"] then
        render.SuppressEngineLighting(true)
    end

    local col = string.ToColor(draghack.cfg.colors["Backtrack chams"])
    draghack.chamMats.invis[6]:SetVector( "$envmaptint", Vector( col.r / 255, col.g / 255, col.b / 255 ) )
    render.MaterialOverride(draghack.chamMats.invis[draghack.cfg["Backtrack material"]]) 
    render.SetColorModulation(col.r/255,col.g/255,col.b/255)
    m:SetRenderMode(1)
    m:DrawModel()

    if draghack.cfg["Backtrack fullbright"] then
        render.SuppressEngineLighting(false)
    end
end

