draghack.cfgTable = {}

function draghack.fillConfigTable()
    local ftbl = file.Find("draghack/*.txt", "DATA")
    draghack.cfgTable = {}

    if not ftbl or #ftbl == 0 then return end

    for i = 1, #ftbl do
        local str = ftbl[i] 
        local len = string.len(str)
        local f = string.sub(str, 1, len - 4)

        draghack.cfgTable[#draghack.cfgTable + 1] = f
    end
end

draghack.fillConfigTable()

function draghack.SaveConfig()
    local tojs = util.TableToJSON(draghack.cfg, false)
    local str = draghack.cfgTable[draghack.cfg["Selected config"]]

    if str then
        file.Write("draghack/" .. str .. ".txt", tojs)
    else
        print("Error: Selected config not found.")
    end
end

function draghack.LoadConfig()
    local str = draghack.cfgTable[draghack.cfg["Selected config"]]
    --print(draghack.cfg["Selected config"])

    if not str or not file.Exists("draghack/" .. str .. ".txt", "DATA") then
        print("Error: Config file not found.")
        return
    end

    local read = file.Read("draghack/" .. str .. ".txt", "DATA")
    local totbl = util.JSONToTable(read)
    if not totbl then
        print("Error: Failed to parse config file.")
        return
    end

    local ConfigName = draghack.cfg["Config name"]
    local SelectedConfig = draghack.cfg["Selected config"]

    for k, v in pairs(totbl) do
        -- НАЧАЛО ИСПРАВЛЕНИЯ
        -- Проверяем, что значение 'v' является таблицей, прежде чем перебирать её
        if type(v) == "table" then
            for key, value in pairs(v) do
                local tbl = draghack.cfg
                
                if k == "vars" then
                    tbl = draghack.cfg
                elseif k == "colors" then
                    tbl = draghack.cfg.colors
                elseif k == "binds" then
                    tbl = draghack.cfg.binds
                -- Этот блок дублирует предыдущий, его можно удалить
                -- elseif k == "binds" then
                --     tbl = draghack.cfg.binds
                elseif k == "friends" then
                    tbl = draghack.cfg.friends
                end
                
                tbl[key] = value 
            end
        end
        -- КОНЕЦ ИСПРАВЛЕНИЯ
    end

    draghack.cfg["Config name"] = ConfigName
    draghack.cfg["Selected config"] = SelectedConfig

    ded.SetInterpolation(draghack.cfg["Disable interpolation"])
    ded.SetSequenceInterpolation(draghack.cfg["Disable Sequence interpolation"])
    local pendingEnableAnimFix = false
    local pendingEnableBoneFix = false

    ded.SetMaxShift(draghack.cfg["Charge ticks"])
    ded.SetMinShift(draghack.cfg["Shift ticks"])
    ded.EnableTickbaseShifting(draghack.cfg["Tickbase shift"])
end

function draghack.CreateConfig()
    local str = draghack.cfg["Config name"]

    if str then
        file.Write("draghack/" .. str .. ".txt", "")
        draghack.fillConfigTable()
        draghack.initTab("Config")
    else
        print("Error: Config name not specified.")
    end
end

function draghack.DeleteConfig()
    local selectedConfigId = draghack.cfg["Selected config"]
    local str = draghack.cfgTable[selectedConfigId]

    if str then
        file.Delete("draghack/" .. str .. ".txt")

        table.remove(draghack.cfgTable, selectedConfigId)

        if #draghack.cfgTable > 0 then
            draghack.cfg["Selected config"] = 1
        else
            draghack.cfg["Selected config"] = nil
        end

        draghack.fillConfigTable()
        draghack.initTab("Config")
    else
        print("Error: Selected config not found.")
    end
end


function draghack.TIME_TO_TICKS(time)
