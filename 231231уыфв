            end
        end

        return lasttick
    end
end

function draghack.SelectTarget( cmd )
    local plys = draghack.GetSortedPlayers( draghack.cfg["Target selection"] )
    draghack.target     = false


    if !plys then return end 

    local maxplys       = draghack.cfg["Max targets"]
    local curplys       = #plys

    if maxplys != 0 and curplys > maxplys then
        curplys = maxplys
    end

    local vEyePos = pLocalPlayer:EyePos()

    local aimAng
    for i = 1, curplys do
		local ply = plys[i][1]

        local iMaxDistance = draghack.cfg[ "Max distance" ]
        local iDistance = vEyePos:DistToSqr( ply:EyePos() )

        if ( iMaxDistance ~= 0 and iDistance > ( iMaxDistance * iMaxDistance ) ) then
            continue 
        end
        






        if not draghack.cfg["Always backtrack"] then
            local bones = draghack.GetBones( ply )

            for o = 1, #bones do
                local bone = bones[o]
                aimAng = ( bone - pLocalPlayer:EyePos() ):Angle()

                if draghack.VisibleCheck( ply, bone, nil, aimAng:Forward() ) then 
                    draghack.target = ply
                    return ply, bone, aimAng, false, 0
                end
            end

        elseif draghack.cfg["Extrapolation"] and draghack.predicted[ ply ] then
            if not draghack.predicted[ ply ].pos then return end

            aimAng = ( draghack.predicted[ ply ].pos - pLocalPlayer:EyePos() ):Angle()

            draghack.traceStruct.start = pLocalPlayer:EyePos()
            draghack.traceStruct.endpos = draghack.predicted[ ply ].pos
            draghack.traceStruct.filter = pLocalPlayer
            draghack.traceStruct.mask = MASK_SHOT

            local tr = TraceLine( draghack.traceStruct )

            if !tr.Hit or tr.Entity == ply then
                draghack.target = ply
                return ply, draghack.predicted[ ply ].pos, aimAng, false, 0
            end
        end

        if draghack.cfg["Backtrack"] then
            local ticks = draghack.FindBacktrack( cmd, ply )

            if draghack.btrecords[ ply ] and not ply.break_lc then 
                local ts = 0 
                
                if draghack.cfg["Backtrack mode"] == 3 then
                    for p = 1, #ticks do
                        if not draghack.btrecords[ ply ][ p ] then continue end

                        aimAng = ( draghack.btrecords[ ply ][ p ].aimpos - pLocalPlayer:EyePos() ):Angle()

                        draghack.traceStruct.start = pLocalPlayer:EyePos()
                        draghack.traceStruct.endpos = draghack.btrecords[ ply ][ p ].aimpos
                        draghack.traceStruct.filter = pLocalPlayer
                        draghack.traceStruct.mask = MASK_SHOT

                        local tr = TraceLine( draghack.traceStruct )

                        if !tr.Hit or tr.Entity == ply then
                            draghack.target = ply
                            draghack.backtracktick = p

                            return ply, draghack.btrecords[ ply ][ p ].aimpos, aimAng, true, p
                        end
                    end
                end

                if draghack.cfg["Backtrack mode"] == 3 then return end

                if draghack.cfg["Backtrack mode"] == 1 then
                    ts = draghack.FindFirstHittableTicks( ply, cmd )
                elseif draghack.cfg["Backtrack mode"] == 2 then
                    ts = draghack.FindClosestHittableTicks( ply, cmd )
                end

                if not draghack.btrecords[ ply ][ ts ] then return end

                aimAng = ( draghack.btrecords[ ply ][ ts ].aimpos - pLocalPlayer:EyePos() ):Angle()

                draghack.traceStruct.start = pLocalPlayer:EyePos()
                draghack.traceStruct.endpos = draghack.btrecords[ ply ][ ts ].aimpos
                draghack.traceStruct.filter = pLocalPlayer
                draghack.traceStruct.mask = MASK_SHOT

                local tr = TraceLine( draghack.traceStruct )

                if !tr.Hit or tr.Entity == ply then
                    draghack.target = ply
                    draghack.backtracktick = ts

                    return ply, draghack.btrecords[ ply ][ ts ].aimpos, aimAng, true, ts
                end
            end
        end
	end
end

