function draghack.Stop(cmd)
    if draghack.validMoveType() and pLocalPlayer:IsFlagSet( FL_ONGROUND ) then

        local moving = draghack.isMoving(cmd)

        if not moving then

            local vel = pLocalPlayer:GetVelocity()
            local dir = vel:Angle()
                
            dir.yaw = draghack.SilentAngle.y - dir.yaw
                
            local newmove = dir:Forward() * vel:Length2D()
        
            cmd:SetForwardMove(0 - newmove.x)
            cmd:SetSideMove(0 - newmove.y)

        end

    end
end

