GAMEMODE["EntityFireBullets"] = function( self, p, data ) 
    if not draghack.activeWeapon then return end

    local tick = engine.TickCount()
    if draghack.cfg[ "On screen logs" ] and data.Src == pLocalPlayer:EyePos() and draghack.aimingrn and draghack.target and not draghack.onScreenLogs[ tick ] and IsFirstTimePredicted() then
        local reason = 1
        
        local tr = {}
        tr.filter = pLocalPlayer 
        tr.start = data.Src 
        tr.endpos = data.Src + data.Dir * 13337
        tr.mask = MASK_SHOT

        tr = TraceLine( tr )

        if draghack.target.break_lc then
            reason = 4
        elseif ded.GetLatency( 0 ) > 0.2 then
            reason = 3
        elseif tr.StartSolid or tr.Hit and tr.Entity != draghack.target then
            reason = 2
        end
        
        local hlcolor = string.ToColor( draghack.cfg.colors[ draghack.MissReasons[ reason ].var ] )
        local data = {
            tick = tick,
            { "Shot at ", draghack.target:Name(), " missed due to ", draghack.MissReasons[ reason ].str, },
            { draghack.HitLogsWhite, hlcolor, draghack.HitLogsWhite, hlcolor, }
        }
            
        draghack.onScreenLogs[ tick ] = data
    end
 
    local spread = data.Spread * -1
    
	if draghack.cones[ draghack.activeWeaponClass ] == spread or spread == draghack.nullVec then return end

    draghack.cones[ draghack.activeWeaponClass ] = spread;
end

