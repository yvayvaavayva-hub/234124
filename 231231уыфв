            surface.SetDrawColor(draghack.Colors[255] or color_white)
            surface.DrawOutlinedRect(0, 0, w, h, 1)
        end

        function c:ValueChanged(col)
            b.Color = col
            draghack.cfg.colors[cfg] = string.format("%d %d %d %d", col.r, col.g, col.b, col.a)
