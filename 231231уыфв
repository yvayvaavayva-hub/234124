function draghack.AddHook( event, func )
    if func == nil and not draghack[ event ] then print("Failed to find hook: " .. event) return end
    local name = util.Base64Encode( event ) .. CurTime()
    hook.Add( event, name, draghack[ event ] or func )
    draghack.hooks[ #draghack.hooks + 1 ] = { event, name }
end

function draghack.RemoveAllHooks()
    for i = #draghack.hooks, 1, -1 do
        local chk = draghack.hooks[i]
        hook.Remove(chk[1], chk[2])
        table.remove(draghack.hooks, i)
    end
end

